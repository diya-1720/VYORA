# VYORA Recommendation & Discovery Engine Configuration

# Internal API port (default 8000)
PORT=8000

# Optional: The Movie Database (TMDB) API Key
# Get your free developer key at: https://www.themoviedb.org/settings/api
# When provided, enables live high-resolution movie posters, backdrops, and trailer links.
TMDB_API_KEY=

# Optional: Google Gemini API Key
# Get your free developer key at: https://aistudio.google.com/
# When provided, enables natural language prompt understanding and AI editorial commentary.
GEMINI_API_KEY=
